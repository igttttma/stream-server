# Copy to .env (loaded by npm start)
PORT=8443
# (The Blimp signs in with the fixed password "blimpmate", built into both apps)
RING_SECONDS=30
# STUN_URLS=stun:stun.l.google.com:19302
# coturn on the VPS (use-auth-secret / static-auth-secret=<TURN_SECRET>):
# TURN_URLS=turn:203.0.113.7:3478?transport=udp,turn:203.0.113.7:3478?transport=tcp
# TURN_SECRET=change-me-too
# Remote screen control (/screen). Unset = off. One device and one viewer at a
# time: the first to connect holds the slot, others are refused.
# Viewers sign in to /screen with this password (5 wrong tries lock an address out for a minute)
# SCREEN_PASSWORD=change-me-4
